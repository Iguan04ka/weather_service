<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create-city-table" author="iguan04ka">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="city" schemaName="public"/>
            </not>
        </preConditions>

        <createTable tableName="city" schemaName="public">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="city_pkey" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="unique_city_name"/>
            </column>

            <column name="weather_id" type="INTEGER">
                <constraints nullable="true" foreignKeyName="fk_city_weather"
                             referencedTableName="weather" referencedColumnNames="id"
                             deleteCascade="true"/>
            </column>

            <column name="lat" type="FLOAT">
                <constraints nullable="true"/>
            </column>

            <column name="lon" type="FLOAT">
                <constraints nullable="true"/>
            </column>
        </createTable>

    </changeSet>
</databaseChangeLog>