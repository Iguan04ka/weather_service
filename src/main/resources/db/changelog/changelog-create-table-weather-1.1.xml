<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create-weather-table" author="iguan04ka">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="weather" schemaName="public"/>
            </not>
        </preConditions>

        <createTable tableName="weather" schemaName="public">
            <column name="id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="weather_pkey" nullable="false"/>
            </column>

            <column name="measured_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>

            <column name="weather_data" type="jsonb">
                <constraints nullable="true"/>
            </column>
        </createTable>

    </changeSet>
</databaseChangeLog>